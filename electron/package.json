{
  "name": "photoframe",
  "version": "1.8.0",
  "description": "Photo Frame for Home Assistant — desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "ru.smartframe.photoframe",
    "productName": "Photo Frame",
    "files": [
      "main.js",
      "preload.js"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
