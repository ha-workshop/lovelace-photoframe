{
  "name": "photoframe",
  "version": "1.9.7",
  "description": "Photo Frame for Home Assistant — desktop app",
  "author": {
    "name": "ha-workshop",
    "email": "enternetacum@yandex.ru"
  },
  "homepage": "https://github.com/ha-workshop/ha-photoframe",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "ru.smartframe.photoframe",
    "productName": "Photo Frame",
    "icon": "icon.png",
    "files": [
      "main.js",
      "preload.js",
      "setup.html"
    ],
    "mac": {
      "category": "public.app-category.lifestyle",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Photo Frame uses the microphone when you talk to the assistant."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4"
  }
}
