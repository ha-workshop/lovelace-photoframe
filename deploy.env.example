# Скопируйте в .deploy.env и заполните. .deploy.env не коммитится.

# Сервер, куда ходим по SSH (ключ должен быть настроен: ssh-copy-id user@host)
DEPLOY_HOST=user@192.168.1.10
# Доп. опции ssh/scp, например порт: SSH_OPTS="-p 2222"
SSH_OPTS=

# ── ./deploy.sh card ── папка конфигурации Home Assistant на этом сервере
# HA Container: каталог, примонтированный в /config (например /opt/homeassistant/config)
HA_CONFIG_DIR=/opt/homeassistant/config
# ── ./deploy.sh pwa ── подпапка в www (откроется как /local/<подпапка>/index.html)
PWA_SUBDIR=photoframe

# ── ./deploy.sh integration ── интеграция ha-photoframe (рядом с этим репозиторием) → custom_components
# INTEGRATION_DIR=../ha-photoframe
# Команда перезапуска HA на сервере (по SSH), например: docker restart homeassistant
# HA_RESTART_CMD=
